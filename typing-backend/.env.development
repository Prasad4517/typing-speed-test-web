NODE_ENV=development
PORT=5000

# Existing MariaDB/MySQL and Redis are required outside injected-repository tests.
# DATABASE_URL=mysql://keystroke:change-me@127.0.0.1:3306/keystroke
DATABASE_URL=mysql://root:pass@localhost:3306/typing_db
DB_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
TRUST_PROXY=false
TRUST_PROXY_HOPS=

# Comma-separated exact browser origins. Production values must use HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

SESSION_TTL_SECONDS=900
TIMING_TOLERANCE_MS=5000
MIN_ELAPSED_MS=500

JWT_ISSUER=keystroke-api
JWT_AUDIENCE=keystroke-web
JWT_SIGNING_KID=local-2026-01
ACCESS_TOKEN_TTL_SECONDS=600
JWT_CLOCK_SKEW_SECONDS=5

# Generate local RSA keys outside the repository:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out jwt-private.pem
# openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Production should mount these from a secret manager. Inline/base64 alternatives
# JWT_PRIVATE_KEY and JWT_PRIVATE_KEY_BASE64 are supported when files are unavailable.
# Leave blank for a process-local development key, or set both paths to the
# key pair generated above. Production requires externally supplied key material.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
# Optional rotation set: JSON object of kid -> "file:/path", "base64:...", or PEM.
JWT_PUBLIC_KEYS_JSON=

REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256
LOCKOUT_THRESHOLD=5
LOCKOUT_SECONDS=900

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Generate independently, never commit the results:
# openssl rand -base64 48  # CSRF_SIGNING_SECRET
# openssl rand -base64 32  # OUTBOX_ENCRYPTION_KEY_BASE64
# Development/test generate process-local values when blank; production fails startup.
CSRF_SIGNING_SECRET=
OUTBOX_ENCRYPTION_KEY_BASE64=

# HTTPS provider endpoint that accepts {to, template, variables}. The outbox worker
# will not start without it. Keep the bearer token in the deployment secret store.
# MAIL_WEBHOOK_URL=https://unexhilarating-allie-cotyledonary.ngrok-free.dev/api/webhooks/resend

# MAIL_WEBHOOK_BEARER_TOKEN=
OUTBOX_POLL_INTERVAL_MS=5000
SECURITY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
OUTBOX_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=500
