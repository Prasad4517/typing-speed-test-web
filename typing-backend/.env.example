NODE_ENV=development
PORT=4000
# Comma-separated browser origins. Keep localhost and 127.0.0.1 if you use both.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
DATABASE_URL=mysql://root:pass@localhost:3306/typing_db
DB_CONNECTION_LIMIT=5
TRUST_PROXY=false
SESSION_TTL_SECONDS=900
TIMING_TOLERANCE_MS=5000
MIN_ELAPSED_MS=500
# Generate a unique value of at least 32 characters. Never reuse this in production.
JWT_ACCESS_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_ISSUER=keystroke-api
JWT_AUDIENCE=keystroke-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_SECURE=false
