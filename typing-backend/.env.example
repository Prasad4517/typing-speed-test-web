NODE_ENV=development
PORT=4000
# Comma-separated browser origins. Keep localhost and 127.0.0.1 if you use both.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
DATABASE_URL=mysql://root:pass@localhost:3306/typing_db
DB_CONNECTION_LIMIT=5
TRUST_PROXY=false
SESSION_TTL_SECONDS=900
TIMING_TOLERANCE_MS=5000
MIN_ELAPSED_MS=500
