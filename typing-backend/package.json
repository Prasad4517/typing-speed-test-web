{
  "name": "typing-speed-test-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "postinstall": "npm run db:generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "NODE_ENV=test DATABASE_URL=mysql://test:test@127.0.0.1:3306/keystroke_test node --test test/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "smoke": "node scripts/smoke.js",
    "jobs:outbox": "node src/jobs/outbox-worker.js",
    "jobs:cleanup": "node src/jobs/security-cleanup.js"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12",
    "mariadb": "^3.5.4",
    "pino-pretty": "^13.1.2",
    "redis": "^5.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.6.2",
    "prisma": "^7.10.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
